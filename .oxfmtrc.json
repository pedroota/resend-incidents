{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "none",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "singleAttributePerLine": false,
  "ignorePatterns": [
    "packages/oxlint/anti-slop/**",
    "**/dist/**",
    "**/src/routeTree.gen.ts",
    "**/src/common/database/migrations/**",
    "**/*.css",
    ".scratch/**"
  ]
}
