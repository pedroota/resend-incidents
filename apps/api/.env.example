# ---- General App Configuration ----
NODE_ENV=local
PORT=3333
API_URL=http://localhost:3333
WEB_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
MAX_USERS=20

# ---- Database & Cache ----
DATABASE_URL=postgresql://resend_incidents:resend_incidents_dev_password@localhost:5433/resend_incidents
REDIS_URL=redis://localhost:6380

# ---- URL Endpoints ----
# Public URL Resend can reach for webhook events (e.g. an ngrok tunnel to the API). Defaults to API_URL.
WEBHOOK_BASE_URL=

# ---- Secrets ----
# openssl rand -base64 48
COOKIE_SECRET=
# openssl rand -base64 48
AUTH_SECRET=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- OAuth / Third-party Authentication ----

# GitHub OAuth app (https://github.com/settings/developers, see README)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public OAuth client registered at https://api.resend.com/oauth/register (see README)
RESEND_CLIENT_ID=

# Discord application (https://discord.com/developers/applications, see README)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
