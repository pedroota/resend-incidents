{
  "name": "@resend-incidents/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "./server",
    "build": "bun build src/main.ts --compile --minify --outfile server",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun run src/common/database/migrate.ts",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:wipe": "bun src/scripts/wipe-database.ts",
    "simulate:bounce-spike": "bun src/scripts/simulate-bounce-spike.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "better-auth": "1.6.23",
    "bullmq": "5.80.2",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.30",
    "ioredis": "5.10.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10"
  }
}
